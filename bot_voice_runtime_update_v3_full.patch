+        actor_id: str,
+        action: str,
+        target_id: str,
+        changed: bool,
+    ) -> None:
+        self._stream_sequence += 1
+        entry_id = f"{self._stream_sequence}-0"
+        self.streams.setdefault(key, []).append(
+            (
+                entry_id,
+                {
+                    "timestamp": timestamp,
+                    "actor_id": actor_id,
+                    "action": action,
+                    "target_id": target_id,
+                    "changed": "1" if changed else "0",
+                },
+            )
+        )
