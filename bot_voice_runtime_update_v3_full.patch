+            return 0
+        if data.get("cancel_requested") == "1":
+            return -1
+        data["lease_deadline"] = deadline
+        self._zadd(leased_key, float(deadline), job_id)
+        return 1
+
+    def _complete(self, keys: list[str], args: list[str]) -> int:
+        leased_key, job_key = keys
