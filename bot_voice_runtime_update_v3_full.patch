+from pathlib import Path
+
+
+class LegacyQueueMigrationTests(unittest.TestCase):
+    def test_ocr_and_transcription_call_sites_enqueue_durable_jobs(self) -> None:
+        source = (
+            Path(__file__).resolve().parents[1] / "app" / "legacy.py"
