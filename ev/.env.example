# ==============================================================================
# 🤖 BOT VOICE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 🔑 MANDATORY CREDENTIALS
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram User ID(s) of administrators (comma-separated if multiple)
ADMIN_IDS=1272791365

# ------------------------------------------------------------------------------
# 2. 🗄️ SUPABASE POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# Publishable/Anon Key (or legacy SUPABASE_KEY)
SUPABASE_KEY=your-supabase-anon-key
# Service Role Key (Required for admin bypass of Row-Level Security)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. 🧠 GOOGLE GEMINI AI
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. ⚡ REDIS CACHE & LOCKING (OPTIONAL BUT HIGHLY RECOMMENDED)
# ------------------------------------------------------------------------------
# e.g., redis://default:password@host:port or rediss://... for Upstash/Redis Cloud
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 5. 🌐 WEB SERVER & WEBHOOK SETTINGS
# ------------------------------------------------------------------------------
PORT=8080
# Optional explicit Webhook Secret Token (auto-generated if omitted)
# TELEGRAM_WEBHOOK_SECRET_TOKEN=your-random-webhook-secret-token

# ------------------------------------------------------------------------------
# 6. 🎙️ TTS ENGINE DEFAULTS
# ------------------------------------------------------------------------------
DEFAULT_TTS_MODEL=auto
DEFAULT_SPEED=1.0
DEFAULT_GENDER=female
HF_MODEL=mrrtmob/khmer-tts
