# ==============================================================================
# 🤖 BOT VOICE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 🔑 MANDATORY CREDENTIALS
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram User ID(s) of administrators (comma-separated if multiple)
ADMIN_IDS=1272791365

# ------------------------------------------------------------------------------
# 2. 🗄️ SUPABASE POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# Publishable/Anon Key (or legacy SUPABASE_KEY)
SUPABASE_KEY=your-supabase-anon-key
# Service Role Key (Required for admin bypass of Row-Level Security)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. 🧠 GOOGLE GEMINI AI
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 4. ⚡ REDIS CACHE & LOCKING (OPTIONAL BUT HIGHLY RECOMMENDED)
# ------------------------------------------------------------------------------
# e.g., redis://default:password@host:port or rediss://... for Upstash/Redis Cloud
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 5. 🌐 WEB SERVER & WEBHOOK SETTINGS
# ------------------------------------------------------------------------------
PORT=8080
# Optional explicit Webhook Secret Token (auto-generated if omitted)
# TELEGRAM_WEBHOOK_SECRET_TOKEN=your-random-webhook-secret-token
# Allowed Telegram update types (comma-separated; must include channel_post for Channel Narrator)
TELEGRAM_ALLOWED_UPDATES=message,edited_message,callback_query,channel_post

# ------------------------------------------------------------------------------
# 6. 🎙️ TTS ENGINE DEFAULTS
# ------------------------------------------------------------------------------
DEFAULT_TTS_MODEL=auto
DEFAULT_SPEED=1.0
DEFAULT_GENDER=female
HF_MODEL=mrrtmob/khmer-tts

# ------------------------------------------------------------------------------
# 7. 📢 CHANNEL AUTO-VOICE NARRATOR
# ------------------------------------------------------------------------------
# Enable auto-narration when bot is admin in Telegram channels (1=enabled, 0=disabled)
CHANNEL_NARRATOR_ENABLED=1
# Voice gender for channel narration: female or male
CHANNEL_NARRATOR_GENDER=female
# Pacing speed (default 1.0)
CHANNEL_NARRATOR_SPEED=1.0
# TTS model for channel narration: auto, edge, gemini, hf_space
CHANNEL_NARRATOR_MODEL=auto
# Maximum characters per post to narrate (default 2000)
CHANNEL_NARRATOR_MAX_CHARS=2000
# Optional channel whitelist (comma-separated chat IDs e.g. -100123456789; empty=all channels where bot is admin)
ALLOWED_CHANNEL_IDS=
