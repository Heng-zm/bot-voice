# Core services
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY
# Fail database calls quickly enough to preserve bot response workers during an outage.
SUPABASE_CONNECT_TIMEOUT_S=5
SUPABASE_HTTP_TIMEOUT_S=12
TELEGRAM_BOT_TOKEN=123456789:REPLACE_ME
GEMINI_API_KEY=REPLACE_ME

# Gemini is the reliable default chat/OCR provider. Set to hf only after
# selecting an HF_MODEL served by an enabled Hugging Face inference provider.
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# First-admin bootstrap. Subsequent Mini App changes are persisted in Supabase.
ADMIN_IDS=123456789

# Optional separate Telegram bot used only to launch/administer the Mini App.
# TELEGRAM_ADMIN_BOT_TOKEN=123456789:REPLACE_ME

# Optional explicit secrets. If omitted, stable values are derived from the
# Telegram bot token; the webhook token is persisted through bot_settings.
# WEB_SECRET_KEY=replace-with-at-least-32-random-characters
# FLASK_SECRET_KEY=replace-with-at-least-32-random-characters
# TELEGRAM_WEBHOOK_SECRET_TOKEN=replace-with-url-safe-secret

# Web/runtime
PORT=8080
BACKEND_ONLY=true
WEB_ADMIN_FRONTEND_ENABLED=false
# RENDER=true
# RENDER_EXTERNAL_URL=https://your-service.onrender.com

# Enable these only when the same bot token runs on multiple services.
# TELEGRAM_MULTI_SERVER_ENABLED=false
# TELEGRAM_ACTIVE_LOCK_ENABLED=false
# TELEGRAM_ACTIVE_LOCK_REQUIRED=false

# Optional provider credentials
# HF_TOKEN=
# GRADIO_TOKEN=

# Single-process Telegram workload protection
# Limits protect CPU/RAM/provider capacity during traffic bursts.
TELEGRAM_OCR_MAX_CONCURRENT=2
TELEGRAM_TRANSCRIBE_MAX_CONCURRENT=2
TELEGRAM_AUDIO_MAX_CONCURRENT=2
TELEGRAM_WORKLOAD_QUEUE_TIMEOUT_S=6

# Preserve updates queued while polling is offline. Change to true only when
# intentionally clearing a stale or broken Telegram backlog.
TELEGRAM_POLLING_DROP_PENDING_UPDATES=false

# Process-local webhook replay protection (single-instance deployment).
WEBHOOK_PROCESSING_TTL_S=120
WEBHOOK_REPLAY_TTL_S=600
WEBHOOK_REPLAY_MAX_ENTRIES=50000
