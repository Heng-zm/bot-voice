# ==============================================================================
# Bot Voice - Environment Configuration Template
# ==============================================================================

# Core Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321
WEBHOOK_SECRET=your_webhook_secret_token
WEBHOOK_URL=https://your-domain.com/webhook
PORT=8080
HOST=0.0.0.0

# Database & Storage (Supabase / Postgres)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATA_DIR=data

# Caching & Concurrency
REDIS_URL=redis://127.0.0.1:6379/0
TTS_CACHE_MAX_ENTRIES=2000

# TTS Engine Configuration
DEFAULT_TTS_MODEL=edge
DEFAULT_TTS_GENDER=female
DEFAULT_TTS_SPEED=1.0
HF_API_TOKEN=your_huggingface_token
EDGE_TTS_VOICE_KHMER_FEMALE=km-KH-SreymomNeural
EDGE_TTS_VOICE_KHMER_MALE=km-KH-PisethNeural

# AI / Vision / Gemini OCR
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Bakong KHQR / Donation Gateway
BAKONG_ACCOUNT_ID=your_account@bkrt
BAKONG_MERCHANT_NAME=YOUR NAME
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_CURRENCY=USD
BAKONG_API_TOKEN=your_bakong_open_api_token
BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh/v1

# Channel Auto-Narrator
ALLOWED_CHANNEL_IDS=
CHANNEL_NARRATOR_ENABLED=true
CHANNEL_NARRATOR_GENDER=female
CHANNEL_NARRATOR_SPEED=1.0

# Telemetry & Observability
LOG_LEVEL=INFO
TELEMETRY_RING_BUFFER_SIZE=1000
AUTH_RATE_LIMIT=60
